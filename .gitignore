# 打包产物
dist/
*.zip

# Python
tests/
__pycache__/
*.py[cod]
.pytest_cache/

# 本地开发资料（体积大、与运行无关）
.references/
.refs/
.validation/
.napcat_docs/
.snowluma_docs/
.zcode/
.zcodeignore
plugin_data/

# 开发期一次性脚本：只保留生成器、打包器与前端工具（sync_forest 被 app.js 注释引用，得跟着走）
tools/*
!tools/gen_qq_actions.py
!tools/package.py
!tools/forest_smoke.js
!tools/forest_preview.html
!tools/sync_forest.py
!tools/webui_mock.js

# 临时探测文件
*.tmp
.chat_body.json
.chat_out.txt
.cfg_body.json
tests_last_run.txt

# 临时提交信息文件（git commit -F 用），不提交
.commit_msg.txt
