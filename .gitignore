# 打包产物
dist/
*.zip

# Python
tests/
__pycache__/
*.py[cod]
.pytest_cache/

# 本地开发资料（体积大、与运行无关）
.references/
.refs/
.validation/
.napcat_docs/
.snowluma_docs/
.zcode/
.zcodeignore
plugin_data/

# 开发工具（生成器/打包器/预览页/假数据）——**不进仓库**：
# 它们只在本机开发时用，运行时不依赖（唯一的引用是 app.js 里的一句注释）。
tools/

# 临时探测文件
*.tmp
.chat_body.json
.chat_out.txt
.cfg_body.json
tests_last_run.txt

# 临时提交信息文件（git commit -F 用），不提交
.commit_msg.txt
